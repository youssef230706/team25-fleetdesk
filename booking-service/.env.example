# Copy this file to .env and fill in the values. Never commit .env.
# In Vercel, add the same names under Settings > Environment Variables.

# Neon connection string (Neon > Connect, pooling on). Use the least-privilege booking_api role.
DATABASE_URL=

# The SAME value as the Fleet service (Kareem sends it privately). At least 32 characters.
JWT_SECRET=

# Frontend addresses allowed to call this API, comma separated, no trailing slash.
CORS_ORIGINS=http://localhost:8080

# Kareem's Fleet API: used to list cars and check each car's availability.
# Locally it defaults to http://localhost:3001. In production it MUST be set.
FLEET_API_URL=

# OpenRouteService (free key from https://openrouteservice.org). Optional: without it,
# bookings still work but have no trip estimate.
ORS_API_KEY=
# Company car park as "longitude,latitude" (default: New Cairo).
COMPANY_ORIGIN=31.4913,30.0131

# ---- Events (optional): signed webhooks to the other services ----
# Comma-separated addresses that receive booking events (for example Ziad's Trip service).
EVENT_WEBHOOK_URLS=
# Shared with the receivers to check the X-FleetDesk-Signature header. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# ---- Alerts (optional) ----
# A Discord / Slack / Teams incoming-webhook address. Treat it like a password.
ALERT_WEBHOOK_URL=
# Alert when this many 401/403 happen within 15 minutes (default 10), or this many Fleet failures (default 3).
ALERT_DENIED_THRESHOLD=10
ALERT_FLEET_THRESHOLD=3

PORT=3002
